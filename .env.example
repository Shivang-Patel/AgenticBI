# Environment Configuration for AgenticBI
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Configuration
# =============================================================================

# OpenAI API Key (required for GPT-based query generation)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model to use (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Ollama base URL (if using local LLMs)
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection string (optional, SQLite used as fallback)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/agenticbi

# SQLite database path (used if DATABASE_URL is not set)
# SQLITE_PATH=./data/agenticbi.db

# =============================================================================
# Vector Store (ChromaDB)
# =============================================================================

# ChromaDB persist directory
CHROMA_PERSIST_DIR=./chroma_db

# Sentence transformer model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# Application Settings
# =============================================================================

# Dash app port (default: 8051)
APP_PORT=8051

# Debug mode (True/False)
DEBUG=False

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# MCP (Model Context Protocol) Settings
# =============================================================================

# MCP server URL (if using external MCP tools)
# MCP_SERVER_URL=http://localhost:3000

# =============================================================================
# Security
# =============================================================================

# Secret key for session management (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# =============================================================================
# Development
# =============================================================================

# Hot reload for development (True/False)
HOT_RELOAD=False
